# Local production copy (docker-compose.prod.yml). Copy to .env.prod: `cp .env.prod.example .env.prod`
# These secrets are for THIS LOCAL COPY ONLY. Generate new ones for the cloud (docs/deployment.md):
# never reuse them on a real deployment.

# ── Postgres (used by the postgres and pgbouncer containers) ────────────────
POSTGRES_USER=clocktime
POSTGRES_PASSWORD=clocktime-local
POSTGRES_DB=clocktime

# App → PgBouncer (pooled, like Neon's -pooler URL); migrations → Postgres directly
DATABASE_URL=postgresql://clocktime:clocktime-local@pgbouncer:6432/clocktime
DIRECT_DATABASE_URL=postgresql://clocktime:clocktime-local@postgres:5432/clocktime
# Long-running servers (this copy, a VM) use bigger pools than serverless instances (5 on Vercel)
DATABASE_POOL_MAX=20

# ── Core ────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8080
BETTER_AUTH_SECRET=local-prod-only-auth-secret-change-for-cloud-0123456789
DATA_ENCRYPTION_KEY=bG9jYWwtcHJvZC1vbmx5LWtleS0zMi1ieXRlcy0hISE=
CRON_SECRET=local-prod-only-cron-secret
SUPER_ADMIN_EMAILS=owner@scale.demo.clocktime.ph
NEXT_PUBLIC_SALES_EMAIL=

# ── Email → Mailpit (open http://localhost:8025) ────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://local:local@mailpit:1025
EMAIL_FROM=ClockTime <no-reply@clocktime.local>

# ── Files → SeaweedFS S3 (keys match docker/seaweedfs/s3.json) ──────────────
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=clocktime-files
S3_ACCESS_KEY_ID=clocktime-local
S3_SECRET_ACCESS_KEY=clocktime-local-secret
S3_FORCE_PATH_STYLE=true

# ── Load testing ────────────────────────────────────────────────────────────
# The load test signs in hundreds of users from one IP; sign-in rate limiting would block it.
# Fine on this local copy; the app refuses to start with this on a real production deployment.
AUTH_RATE_LIMIT=off
CRON_TARGET_URL=http://proxy
