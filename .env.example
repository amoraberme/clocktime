# Postgres connection string
DATABASE_URL="postgresql://clocktime:clocktime@localhost:5432/clocktime"
# Public base URL of the app (used for links in emails, auth callbacks)
APP_URL="http://localhost:3000"
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Key for encrypting government ID numbers at rest (32 bytes base64): `openssl rand -base64 32`
DATA_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
# Protects /api/cron/* endpoints (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me"
# Email: "console" (dev) or "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="ClockTime <no-reply@example.com>"
# File storage: "local" (dev, ./storage) or "s3" (R2/S3)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Web Push (generate with `pnpm dlx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"
# PayMongo (test keys start with sk_test_ / pk_test_)
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Comma-separated emails that get the ClockTime super-admin console
SUPER_ADMIN_EMAILS=""
