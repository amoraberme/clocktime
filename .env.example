# ClockTime environment. Copy to .env for local development.
# [prod] = required on the live site (startup checks refuse to run without it when VERCEL_ENV or
# DEPLOY_ENV is "production"). Full guide: docs/deployment.md

# ── Database ────────────────────────────────────────────────────────────────
# [prod] App connection. In production use the provider's POOLED URL (Neon: the "-pooler" host).
DATABASE_URL="postgresql://clocktime:clocktime@localhost:5432/clocktime"
# [prod] Direct (non-pooled) URL used only by `prisma migrate deploy`. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=""
# Connections per server instance (default 5). Keep instances × this under the pooler's limit.
DATABASE_POOL_MAX="5"

# ── Core ────────────────────────────────────────────────────────────────────
# [prod] Public https:// address (links in emails, auth callbacks, terminal setup instructions)
APP_URL="http://localhost:3000"
# [prod] 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# [prod] 32 bytes, base64: `openssl rand -base64 32`. Encrypts government IDs, bank accounts, RFID
# cards and webhook secrets. NEVER change it after go-live: encrypted data becomes unreadable.
DATA_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
# [prod] Protects /api/cron/* (Vercel Cron sends it as a Bearer token). 16+ characters.
CRON_SECRET="change-me"
# Comma-separated emails that get the ClockTime super-admin console
SUPER_ADMIN_EMAILS=""
# Shown on the pricing page for Enterprise quotes
NEXT_PUBLIC_SALES_EMAIL=""

# ── Email ───────────────────────────────────────────────────────────────────
# [prod] "resend" in production ("console" prints emails to the log in development)
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="ClockTime <no-reply@example.com>"

# ── File storage (payslips, punch photos) ───────────────────────────────────
# [prod] "s3" in production (Cloudflare R2 or any S3-compatible store); "local" writes to ./storage
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Web Push (generate with `pnpm dlx web-push generate-vapid-keys`) ───────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# ── PayMongo subscription billing (test keys start with sk_test_ / pk_test_) ─
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# ── Hosting outside Vercel ──────────────────────────────────────────────────
# Set to "production" on a live non-Vercel host to turn on the production checks.
DEPLOY_ENV=""

# ── Testing only: must be unset on the live site (startup refuses otherwise) ─
# Simulated checkout without PayMongo keys
BILLING_TEST_MODE=""
# "off" disables sign-in rate limiting (end-to-end tests)
AUTH_RATE_LIMIT=""
