{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/exceptions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/auto-clockout",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/recurrences",
      "schedule": "17 18 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "43 19 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "7 1 * * *"
    }
  ]
}
